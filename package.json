{
  "name": "radar-ia",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--use-system-ca tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node --use-system-ca dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^0.453.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.18.0"
}
